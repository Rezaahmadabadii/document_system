# جلوگیری از دسترسی مستقیم به فایل‌های حساس
<FilesMatch "^\.(htaccess|htpasswd|ini|log|sh|sql|bak)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# جلوگیری از لیست شدن محتویات پوشه
Options -Indexes

# تنظیم پیش‌فرض charset
AddDefaultCharset UTF-8

# مسدود کردن دسترسی به فایل‌های PHP در پوشه storage (اما اجازه به تصاویر)
RewriteEngine On
RewriteRule ^storage/.*\.(php|phtml)$ - [F,L]